<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:batch="http://www.springframework.org/schema/batch" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/batch
		http://www.springframework.org/schema/batch/spring-batch-2.2.xsd
		http://www.springframework.org/schema/beans 
		http://www.springframework.org/schema/beans/spring-beans-3.2.xsd
	">

	<import resource="classpath:jobs/InvioFattureElettroniche_JobOperations.xml" />

	<batch:job id="JOB_INVIO_FATTUREELETTRONICHE">
		<!-- <batch:listeners>
	        <batch:listener ref="jobExecutionListener"/>
	    </batch:listeners> -->
		<batch:step id="invioPathCreation" next="preparazioneFatture">
			<batch:tasklet ref="pathCreatorTasklet" />
		</batch:step>
		<batch:step id="preparazioneFatture" next="preparazioneNoteCredito">
			<batch:tasklet>
				<batch:chunk reader="invioFattureReader" processor="invioFattureProcessor" writer="invioFattureWriter" commit-interval="1">
				</batch:chunk>
			</batch:tasklet>
		</batch:step>
<!-- 		<batch:step id="invioSupporti" next="preparazioneNoteCredito"> -->
<!-- 			<batch:tasklet ref="invioSupportiTasklet" /> -->
<!-- 		</batch:step> -->
		<batch:step id="preparazioneNoteCredito" next="invioNoteCredito">
			<batch:tasklet>
				<batch:chunk reader="invioNoteCreditoReader" processor="invioNoteCreditoProcessor" writer="invioNoteCreditoWriter" commit-interval="1">
				</batch:chunk>
			</batch:tasklet>
		</batch:step>
		<batch:step id="invioNoteCredito">
			<batch:tasklet ref="invioSupportiTasklet" />
		</batch:step>
<!-- 		<batch:step id="aggiornaFatture"> -->
<!-- 			<batch:tasklet ref="aggiornaFattureInviateTasklet" /> -->
<!-- 		</batch:step> -->
	</batch:job>

</beans>