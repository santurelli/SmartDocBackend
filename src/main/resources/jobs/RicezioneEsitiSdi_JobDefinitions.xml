<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:batch="http://www.springframework.org/schema/batch" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/batch
		http://www.springframework.org/schema/batch/spring-batch-2.2.xsd
		http://www.springframework.org/schema/beans 
		http://www.springframework.org/schema/beans/spring-beans-3.2.xsd
	">

	<import resource="classpath:jobs/RicezioneEsitiSdi_JobOperations.xml" />

	<batch:job id="JOB_RICEZIONE_ESITISDI">
		<!-- <batch:listeners>
	        <batch:listener ref="jobExecutionListener"/>
	    </batch:listeners> -->
		<batch:step id="esitiSdiPathCreation" next="letturaEsitiSdi">
			<batch:tasklet ref="ricezioneEsitiSdiPathCreatorTasklet" />
		</batch:step>
		<batch:step id="letturaEsitiSdi" next="invioNotifiche">
			<batch:tasklet>
				<batch:chunk reader="esitiSdiReader" processor="esitiSdiProcessor" writer="esitiSdiWriter" commit-interval="1">
				</batch:chunk>
			</batch:tasklet>
		</batch:step>
		<batch:step id="invioNotifiche">
			<batch:tasklet ref="invioNotificheTasklet" />
		</batch:step>
	</batch:job>

</beans>