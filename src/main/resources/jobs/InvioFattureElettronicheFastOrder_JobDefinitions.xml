<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:batch="http://www.springframework.org/schema/batch" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/batch
		http://www.springframework.org/schema/batch/spring-batch-2.2.xsd
		http://www.springframework.org/schema/beans 
		http://www.springframework.org/schema/beans/spring-beans-3.2.xsd
	">

	<import resource="classpath:jobs/InvioFattureElettronicheFastOrder_JobOperations.xml" />

	<batch:job id="JOB_INVIO_FATTUREELETTRONICHE_FASTORDER">
		<!-- <batch:listeners>
	        <batch:listener ref="jobExecutionListener"/>
	    </batch:listeners> -->
		<batch:step id="pathCreationfastOrder" next="preparazioneFattureFastOrder">
			<batch:tasklet ref="pathCreatorFastOrderTasklet" />
		</batch:step>
		<batch:step id="preparazioneFattureFastOrder" next="invioSupportiFastOrder">
			<batch:tasklet>
				<batch:chunk reader="invioFattureFastOrderReader" processor="invioFattureFastOrderProcessor" writer="invioFattureFastOrderWriter" commit-interval="1">
				</batch:chunk>
			</batch:tasklet>
		</batch:step>
<!-- 		<batch:step id="preparazioneFattureFastOrder"> -->
<!-- 			<batch:tasklet> -->
<!-- 				<batch:chunk reader="invioFattureFastOrderReader" writer="invioFattureFastOrderWriter" commit-interval="1"> -->
<!-- 				</batch:chunk> -->
<!-- 			</batch:tasklet> -->
<!-- 		</batch:step> -->
		<batch:step id="invioSupportiFastOrder">
			<batch:tasklet ref="invioSupportiFastOrderTasklet" />
		</batch:step>
	</batch:job>

</beans>