<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:batch="http://www.springframework.org/schema/batch" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/batch
		http://www.springframework.org/schema/batch/spring-batch-2.2.xsd
		http://www.springframework.org/schema/beans 
		http://www.springframework.org/schema/beans/spring-beans-3.2.xsd
	">

	<import resource="classpath:jobs/RicezioneEsitiInvio_JobOperations.xml" />

	<batch:job id="JOB_RICEZIONE_ESITIINVIO">
		<!-- <batch:listeners>
	        <batch:listener ref="jobExecutionListener"/>
	    </batch:listeners> -->
		<batch:step id="esitiInvioPathCreation" next="letturaEsitiInvio">
			<batch:tasklet ref="esitiInvioPathCreatorTasklet" />
		</batch:step>
		<batch:step id="letturaEsitiInvio">
			<batch:tasklet>
				<batch:chunk reader="esitiInvioReader" processor="esitiInvioProcessor" writer="esitiInvioWriter" commit-interval="1">
				</batch:chunk>
			</batch:tasklet>
		</batch:step>
	</batch:job>

</beans>