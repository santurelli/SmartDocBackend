<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:batch="http://www.springframework.org/schema/batch" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/batch
		http://www.springframework.org/schema/batch/spring-batch-2.2.xsd
		http://www.springframework.org/schema/beans 
		http://www.springframework.org/schema/beans/spring-beans-3.2.xsd
	">

	<import resource="classpath:jobs/InvioFattureElettronichePiuForty_JobOperations.xml" />

	<batch:job id="JOB_INVIO_FATTUREELETTRONICHE_PIUFORTY">
		<!-- <batch:listeners>
	        <batch:listener ref="jobExecutionListener"/>
	    </batch:listeners> -->
		<batch:step id="pathCreationPiuForty" next="preparazioneFatturePiuForty">
			<batch:tasklet ref="pathCreatorPiuFortyTasklet" />
		</batch:step>
		<batch:step id="preparazioneFatturePiuForty" next="invioSupportiPiuForty">
			<batch:tasklet>
				<batch:chunk reader="invioFatturePiuFortyReader" processor="invioFatturePiuFortyProcessor" writer="invioFatturePiuFortyWriter" commit-interval="1">
				</batch:chunk>
			</batch:tasklet>
		</batch:step>
		<batch:step id="invioSupportiPiuForty">
			<batch:tasklet ref="invioSupportiPiuFortyTasklet" />
		</batch:step>
	</batch:job>

</beans>