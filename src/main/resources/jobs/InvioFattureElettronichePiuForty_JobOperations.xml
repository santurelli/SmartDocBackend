	<!--################################### TASKLET SECTION ###############################################-->
	<bean id="pathCreatorPiuFortyTasklet" class="it.tinna.smartdoc.batch.tasklet.InvioFattureSdiPathCreatorTasklet" scope="step">
<!-- 		<property name="templateDir" value="#{configurazioneDelegate.getByKey(T(it.tinna.smartdoc.batch.constants.BatchConstants).CONFIG_DOMAIN_BATCH, T(it.tinna.smartdoc.batch.constants.BatchConstants).CONFIG_KEY_WORKDIR)}"></property> -->
		<property name="dbKey" value="#{jobParameters[T(it.tinna.smartdoc.batch.constants.BatchConstants).JOBPARAM_NOME_STORE]}"></property>
	</bean>
	
	<bean id="invioSupportiPiuFortyTasklet" class="it.tinna.smartdoc.batch.tasklet.InviaSupportiSdiTasklet" scope="step">
		<property name="dbKey" value="#{jobParameters[T(it.tinna.smartdoc.batch.constants.BatchConstants).JOBPARAM_DB_KEY]}"></property>
	</bean>
	
	<!--################################### READER SECTION ###############################################-->
	<bean id="invioFatturePiuFortyReader" class="it.tinna.smartdoc.batch.readers.invio.InvioFattureElettronicheJustDesignReader" scope="step">
		<property name="dbKey" value="#{jobParameters[T(it.tinna.smartdoc.batch.constants.BatchConstants).JOBPARAM_DB_KEY]}"></property>
		<property name="pathFattura" value="#{jobParameters[T(it.tinna.smartdoc.batch.constants.BatchConstants).JOBPARAM_JSON_FATTURA_ENCODED]}"></property>
		<property name="nomeStore" value="#{jobParameters[T(it.tinna.smartdoc.batch.constants.BatchConstants).JOBPARAM_NOME_STORE]}"></property>
	</bean>
	<!--################################### PROCESSOR SECTION ###############################################-->
	<bean id="invioFatturePiuFortyProcessor" class="org.springframework.batch.item.support.CompositeItemProcessor" scope="step">
		<property name="delegates">
			<list value-type="org.springframework.batch.item.ItemProcessor">
				<ref bean="memorizzaFatturaElettronicaPiuFortyProcessor" />
				<ref bean="generaNomeFilePiuFortyProcessor" />
			</list>
		</property>
	</bean>
	<bean id="generaNomeFilePiuFortyProcessor" class="it.tinna.smartdoc.batch.processors.inviofatturelettroniche.GeneraNomeFileFatturaElettronicaProcessor" scope="step">
	</bean>
	<bean id="memorizzaFatturaElettronicaPiuFortyProcessor" class="it.tinna.smartdoc.batch.processors.inviofatturelettroniche.MemorizzaFatturaElettronicaProcessor" scope="step">
		<property name="dbKey" value="#{jobParameters[T(it.tinna.smartdoc.batch.constants.BatchConstants).JOBPARAM_NOME_STORE]}"></property>
	</bean>
	<!--################################### WRITER SECTION ###############################################-->
	<bean id="invioFatturePiuFortyWriter" class="it.tinna.smartdoc.batch.writers.invio.InvioFattureElettronicheWriter" scope="step">
		<property name="dbKey" value="#{jobParameters[T(it.tinna.smartdoc.batch.constants.BatchConstants).JOBPARAM_DB_KEY]}"></property>
		<property name="comandoFirma" value="#{configurazioneDelegate.getByKey(T(it.tinna.smartdoc.batch.constants.BatchConstants).CONFIG_DOMAIN_BATCH_INVIO_SDI, T(it.tinna.smartdoc.batch.constants.BatchConstants).CONFIG_KEY_COMANDO_FIRMA)}"></property>
		<property name="stepExecution" value="#{stepExecution}"></property>
	</bean>
</beans>