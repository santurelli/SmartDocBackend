<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:batch="http://www.springframework.org/schema/batch" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/batch
		http://www.springframework.org/schema/batch/spring-batch-2.2.xsd
		http://www.springframework.org/schema/beans 
		http://www.springframework.org/schema/beans/spring-beans-3.2.xsd
	">
	<!--################################### GENERAL SECTION ###############################################-->
	
	<!--################################### TASKLET SECTION ###############################################-->
	<bean id="ricezioneEsitiSdiPathCreatorTasklet" class="it.tinna.smartdoc.batch.tasklet.PathCreatorTasklet" scope="step">
	</bean>
	<bean id="invioNotificheTasklet" class="it.tinna.smartdoc.batch.tasklet.InvioNotificheScartiTasklet" scope="step">
		<property name="freeMarkerConfiguration" ref="freeMarkerConfiguration"></property>
		<property name="mailSenderService" ref="mailSenderServiceFastOrder"></property>
		<property name="scartiExtractor">
			<bean class="it.tinna.smartdoc.batch.service.scarti.ScartiGenericoExtractor"></bean>
		</property>
	</bean>
	<!--################################### READER SECTION ###############################################-->
	<bean id="esitiSdiReader" class="it.tinna.smartdoc.batch.readers.esitisdi.EsitiSdiReader" scope="step">
		<property name="cartellaEsiti" value="#{configurazioneDelegate.getByKeyFromServiceDb(T(it.tinna.smartdoc.batch.constants.BatchConstants).CONFIG_DOMAIN_BATCH_ESITI_SDI, T(it.tinna.smartdoc.batch.constants.BatchConstants).CONFIG_KEY_CARTELLA_ESITI)}"></property>
		<property name="stepExecution" value="#{stepExecution}"></property>
	</bean>
	<!--################################### PROCESSOR SECTION ###############################################-->
	<bean id="esitiSdiProcessor" class="it.tinna.smartdoc.batch.processors.esitisdi.EsitiSdiProcessor" scope="step">
		<property name="stepExecution" value="#{stepExecution}"></property>
		<property name="comandoDecifratura" value="#{configurazioneDelegate.getByKeyFromServiceDb(T(it.tinna.smartdoc.batch.constants.BatchConstants).CONFIG_DOMAIN_BATCH_ESITI_SDI, T(it.tinna.smartdoc.batch.constants.BatchConstants).CONFIG_KEY_COMANDO_DECIFRATURA)}"></property>
		<property name="comandoVerificaFirma" value="#{configurazioneDelegate.getByKeyFromServiceDb(T(it.tinna.smartdoc.batch.constants.BatchConstants).CONFIG_DOMAIN_BATCH_ESITI_SDI, T(it.tinna.smartdoc.batch.constants.BatchConstants).CONFIG_KEY_COMANDO_VERIFICA_FIRMA)}"></property>
	</bean>
	<!--################################### WRITER SECTION ###############################################-->
	<bean id="esitiSdiWriter" class="it.tinna.smartdoc.batch.writers.esitisdi.EsitiSdiWriter" scope="step">
		<property name="stepExecution" value="#{stepExecution}"></property>
		<property name="comandoVerificaFirma" value="#{configurazioneDelegate.getByKeyFromServiceDb(T(it.tinna.smartdoc.batch.constants.BatchConstants).CONFIG_DOMAIN_BATCH_ESITI_SDI, T(it.tinna.smartdoc.batch.constants.BatchConstants).CONFIG_KEY_COMANDO_VERIFICA_FIRMA)}"></property>
	</bean>
</beans>